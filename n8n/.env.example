# Copy to n8n/.env (git-ignored). Values are read by the Code nodes via $env.

# Same value as N8N_SHARED_SECRET in the Convex deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LENDLOOP_SHARED_SECRET=

# Convex HTTP actions URL as seen from inside the n8n container.
# Local Convex (npx convex dev --local):  http://host.docker.internal:3211
# Convex cloud:                          https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
