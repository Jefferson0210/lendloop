{
  "id": "LLoopOverdue0001",
  "name": "LendLoop · Daily overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLoopErrors00001",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000001",
      "name": "Every day at 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000008",
      "name": "Run now (manual test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000002",
      "name": "Sign overdue query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GET requests are signed too: `${timestamp}.GET./n8n/overdue-loans.` (empty body).\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_SHARED_SECRET;\nif (!secret) throw new Error('LENDLOOP_SHARED_SECRET is not set in the n8n environment');\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.GET./n8n/overdue-loans.`).digest('hex');\nreturn [{ json: { headers: { 'X-LendLoop-Timestamp': timestamp, 'X-LendLoop-Signature': signature } } }];"
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000003",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($json.headers) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000004",
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Convex already excludes loans reminded today, so re-running the workflow\n// the same day does not message anyone twice. No loans -> no items -> done.\nconst { date, loans } = $input.first().json;\nreturn (loans || []).map((loan) => ({ json: { date, ...loan } }));"
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000005",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Delivery is mocked as a log line; swap for Email/Slack/Discord in production.\nconst days = $json.daysOverdue;\nconst text = `Hi ${$json.borrower.name}, the ${$json.toolName} was due back on ${$json.endDate} (${days} day${days === 1 ? '' : 's'} ago). Please return it or contact the owner.`;\nconsole.log(`[LendLoop] reminder to ${$json.borrower.name} <${$json.borrower.email || 'no email'}>: ${text}`);\nreturn { json: { loanId: $json.loanId, date: $json.date, status: 'sent', channel: 'mock-log', to: $json.borrower.name, message: text } };"
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000006",
      "name": "Sign reminder status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Idempotency key on the Convex side is loanId + date, so retries never duplicate.\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_SHARED_SECRET;\nconst path = '/n8n/reminder-status';\nconst body = JSON.stringify({ loanId: $json.loanId, date: $json.date, status: $json.status, channel: $json.channel });\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.POST.${path}.${body}`).digest('hex');\nreturn { json: { body, headers: { 'Content-Type': 'application/json', 'X-LendLoop-Timestamp': timestamp, 'X-LendLoop-Signature': signature } } };"
      }
    },
    {
      "id": "7c1d2e5f-2b02-4d2f-8b20-000000000007",
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminder-status",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($json.headers) }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "Every day at 09:00 UTC": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue query": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock)": {
      "main": [
        [
          {
            "node": "Sign reminder status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign reminder status": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual test)": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
