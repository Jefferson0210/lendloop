# Copy to .env.local. `npx convex dev` fills in the CONVEX_* values automatically.

# --- Convex (written by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Clerk (Dashboard -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Set these in the Convex deployment, NOT here ---
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set N8N_SHARED_SECRET <same value as LENDLOOP_SHARED_SECRET in n8n/.env>
#   npx convex env set N8N_LOAN_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-event
#   npx convex env set ADMIN_EMAILS you@example.com        (optional, comma-separated)
